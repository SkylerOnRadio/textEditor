#include <memory>
#include <ncurses.h>
#include <utility>

#define CTRL(key) (key & 0x1F)

class Letter {
public:
  char letter;
  std::unique_ptr<Letter> next;
  Letter *prev;
  Letter(char letter) {
    this->letter = letter;
    next = nullptr;
    prev = nullptr;
  }
};

std::unique_ptr<Letter> start = nullptr;
Letter *end = nullptr;

void addLetter(char letter) {
  std::unique_ptr<Letter> newLetter = std::make_unique<Letter>(letter);
  Letter *rawLetter = newLetter.get();
  newLetter->prev = end;

  if (start == nullptr) {
    start = std::move(newLetter);
    end = rawLetter;
  } else {
    end->next = std::move(newLetter);
    end = rawLetter;
  }
}

void deleteLastLetter() {
  if (end == nullptr)
    return;

  if (start.get() == end) {
    end = nullptr;
    start.reset();
    return;
  }

  end = end->prev;
  end->next.reset();
}

void displayText(WINDOW *win) {
  werase(win);
  box(win, 0, 0);
  int maxy, maxx;
  getmaxyx(win, maxy, maxx);
  int y{1};
  int x{1};

  Letter *l = start.get();
  while (l != nullptr) {
    if (x == maxx) {
      y++;
      x = 1;
    }
    if (y == maxy)
      return;
    mvwaddch(win, y, x, l->letter);
    l = l->next.get();
    x++;
  }
  wmove(win, y, x);
  wrefresh(win);
}

int main() {
  WINDOW *mainWindow;

  initscr();
  raw();
  keypad(mainWindow, true);
  noecho();
  curs_set(1);

  mainWindow = newwin(LINES, COLS, 0, 0);
  wmove(mainWindow, 1, 1);

  box(mainWindow, 0, 0);
  // std::cerr << "made the box";
  wrefresh(mainWindow);
  int exit{0};
  while (1) {
    int l = wgetch(mainWindow);
    switch (l) {
    case CTRL('q'):
      exit = 1;

    case 127:
      deleteLastLetter();
      break;

    default:
      addLetter(static_cast<char>(l));
    }
    if (exit == 1)
      break;

    displayText(mainWindow);
  }
}
